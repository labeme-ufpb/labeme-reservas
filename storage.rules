rules_version = '2';
// Fotos enviadas pelo sistema (perfil, devolução, materiais, equipamentos) — v11.4
// Só JPG/PNG/WebP (sem SVG, que pode carregar código), até 5 MB, sem sobrescrever arquivos existentes.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{all=**} {
      allow read: if request.auth != null;
    }
    match /uploads/{coll}/{docId}/{file} {
      allow create: if request.auth != null
                    && coll in ['users', 'resources', 'reservations', 'stock']
                    && docId.matches('^[A-Za-z0-9_-]{1,64}$')
                    && file.matches('^[A-Za-z0-9_.-]{1,80}$')
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
